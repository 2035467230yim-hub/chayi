. * ---------------------- 方案2：城市内部随机错配年份 ----------------------
. tempname hcity

. postfile `hcity' int rep ///
>     double b_demo se_demo t_demo p_demo b_stru se_stru t_stru p_stru ///
>     byte both_neg10 using `draws_city', replace
(file C:\Users\Nfoh\AppData\Local\Temp\ST_d14_000004.tmp not found)

. set seed 20261109

. forvalues r=1/$REPS {
  2.     preserve
  3.         use `base_panel', clear
  4.         tempfile main draw
  5.         tempvar u rank u2
  6.         gen double `u'=runiform()
  7.         bysort id (`u'): gen long `rank'=_n
  8.         save `main', replace
  9. 
.         keep id `rank' demo L1_stru
 10.         rename demo placebo_demo
 11.         rename L1_stru placebo_L1_stru
 12.         gen double `u2'=runiform()
 13.         bysort id (`u2'): replace `rank'=_n
 14.         save `draw', replace
 15. 
.         use `main', clear
 16.         merge m:1 id `rank' using `draw', nogen keep(match)
 17.         quietly reghdfe abs_gap placebo_demo placebo_L1_stru $CTRL, ///
>             absorb(id province_year) vce(cluster id)
 18.         local bd=_b[placebo_demo]
 19.         local sd=_se[placebo_demo]
 20.         local td=`bd'/`sd'
 21.         local pd=2*ttail(e(df_r),abs(`td'))
 22.         local bs=_b[placebo_L1_stru]
 23.         local ss=_se[placebo_L1_stru]
 24.         local ts=`bs'/`ss'
 25.         local ps=2*ttail(e(df_r),abs(`ts'))
 26.         local joint=(`bd'<0 & `pd'<.10 & `bs'<0 & `ps'<.10)
 27.         post `hcity' (`r') (`bd') (`sd') (`td') (`pd') ///
>             (`bs') (`ss') (`ts') (`ps') (`joint')
 28.     restore
 29.     if mod(`r',100)==0 display as text "城市内年份错配：`r'/1000"
 30. }
